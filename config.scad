// ============================================================
//  ECO-DRYER (Ranque-Hilsch) — CONFIG
//  Эко-Сушилка для микрозелени и ягод на эффекте Ранка-Хилша
//  ------------------------------------------------------------
//  Единая точка правки всех размеров. Меняйте значения здесь —
//  вся модель в других файлах пересчитается автоматически.
//  All dimensions in millimeters (mm).
//  Do NOT open this file's geometry directly — open scad/main.scad.
// ============================================================

// ---------- Render quality / Качество рендера ----------
// Низкое качество в preview (F5) — быстро крутить модель,
// высокое — для финального рендера (F6) и экспорта STL.
$fn = $preview ? 48 : 128;

// ---------- Vortex generator / Вихревой генератор ----------
d_chamber          = 30;    // внутр. диаметр вихревой камеры
wall               = 2.4;   // толщина стенок (мин. 2 линии экструдера)
n_nozzles          = 2;     // число тангенциальных сопел (обычно 1-4)
d_nozzle           = 3.0;   // диаметр сопла, мм
chamber_len        = d_chamber * 0.6; // длина генераторной части

// ---------- Hot tube / Горячая труба ----------
l_hot_tube         = 200;   // длина горячей трубы
                             // L/D ~ 6..8  — компактно (эта модель)
                             // L/D ~ 15..25 — для максимальной ΔT

// ---------- Cold orifice (диафрагма холодного конца) ----------
cold_orifice_ratio = 0.38;  // d_cold/d_chamber, эмпирика R-H: 0.3-0.5
d_cold_orifice     = d_chamber * cold_orifice_ratio;
diaphragm_t        = 3.0;   // толщина диафрагмы

// ---------- Hot-end control valve / Регулировочный клапан ----------
valve_cone_angle   = 25;    // угол конуса, град
valve_cone_len     = 14;    // длина конуса
valve_rod_d        = 6;     // диаметр штока клапана
valve_travel       = 20;    // ход регулировки, мм
pin_hole_d         = 2.2;   // диаметр отверстия фиксатора (штифт/скрепка)
pin_hole_pitch     = 4;     // шаг отверстий фиксации по длине штока
housing_vent_n     = 6;     // число вентиляционных прорезей горячего выхода
housing_vent_w     = 4;     // ширина прорези

// ---------- Flanges & fasteners / Фланцы и крепёж ----------
flange_t           = 4;     // толщина фланца
flange_extra       = 12;    // добавка к диаметру фланца (под винты)
chamber_od         = d_chamber + 2 * wall;    // наружный диаметр камеры/трубы
flange_od          = chamber_od + flange_extra; // наружный диаметр фланцев
m3_insert_d        = 4.0;   // отверстие под латунную термовставку M3x5.7
m3_insert_depth    = 6.0;
m3_clear_d         = 3.4;   // сквозное отверстие под винт M3

// ---------- O-ring seal / Уплотнительное кольцо ----------
oring_cs           = 2.0;                 // сечение шнура (2 мм NBR)
oring_groove_w     = oring_cs * 1.35;
oring_groove_d     = oring_cs * 0.75;

// ---------- Air hose barbs / Штуцеры под шланг ----------
hose_id_supply     = 6.0;   // подача воздуха от компрессора (силикон 6/9 мм)
hose_id_cold       = 8.0;   // холодный воздух -> сушильная камера (8/11 мм)
barb_len           = 12;
barb_rings         = 3;

// ---------- Drying chamber / Сушильная камера ----------
chamber_w          = 140;
chamber_d          = 140;
chamber_h          = 165;
box_wall           = 2.4;
box_corner_r       = 8;     // радиус скругления углов (гигиенично, легко мыть)
lid_lip_h          = 6;     // высота посадочного борта крышки
inlet_port_z       = 18;    // высота входного порта холодного воздуха от дна
vent_hole_d        = 3.0;   // диаметр вент.отверстий крышки (выход влажного воздуха)
vent_hole_pitch    = 7.0;

// ---------- Trays / Лотки для микрозелени и ягод ----------
n_trays            = 3;
tray_gap           = 32;    // шаг направляющих по высоте
tray_wall          = 2.0;
tray_border        = 9;     // высота бортика лотка
tray_hole_d        = 2.6;   // диаметр перфорации (держит ягоды/микрозелень, пропускает воздух)
tray_hole_pitch    = 5.5;
tray_clear         = 0.6;   // технологический зазор лоток/направляющая
rail_w             = 3;     // ширина направляющей рейки
rail_h             = 3;     // высота (выступ) направляющей рейки

// ---------- Assembly helpers / Помощники сборки ----------
// Зазор между узлами при exploded=true (для наглядных иллюстраций)
explode_gap        = 25;
